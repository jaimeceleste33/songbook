# Postgres. In production use Neon's POOLED connection string (the host with
# the `-pooler` suffix) — serverless invocations exhaust an unpooled endpoint.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# The single password the singer types to get in.
SONGBOOK_PASSWORD="change-me"

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
