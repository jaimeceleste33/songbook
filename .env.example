# Postgres connection string.
#
# The app looks for DATABASE_URL, then STORAGE_URL, then POSTGRES_URL, and uses
# the first one set. Marketplace integrations create and rotate their own
# variable, so let the integration own it rather than copying the value into a
# second variable — a hand-made copy goes stale the first time it rotates.
#
# In production it must be the POOLED endpoint (host ending in `-pooler`).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# The single password the singer types to get in.
SONGBOOK_PASSWORD="change-me"

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
