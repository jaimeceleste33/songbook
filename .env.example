# Neon Postgres. Provisioned through the Vercel Marketplace integration;
# after connecting it run `vercel env pull .env.local` to get the real value.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# The single password the singer types to get in.
SONGBOOK_PASSWORD="change-me"

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"
